# Copy this file to `.env` and fill it in. `.env` is git-ignored.
# On Streamlit Community Cloud, put the same keys in App settings > Secrets
# (see .streamlit/secrets.toml.example).

# ---------------------------------------------------------------- general
# Public address of the deployed app. Used for the share QR and challenge links.
BLOODLINE_PUBLIC_URL=http://localhost:8501

# Repository opened by the "Source code" menu option.
BLOODLINE_REPO_URL=https://github.com/AbrSantiago/bloodline

# Where finished games are stored for the leaderboard: "csv" or "gsheets".
# "csv" needs nothing else and is the right choice for local development.
BLOODLINE_STORAGE=csv
BLOODLINE_CSV_PATH=.data/results.csv

# ---------------------------------------------------------------- Google Sheets (only if BLOODLINE_STORAGE=gsheets)
# The id is the long part of the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GSHEETS_RESULTS_SPREADSHEET_ID=
GSHEETS_RESULTS_WORKSHEET=results

# Service account credentials. Use ONE of the two:
# a path to the JSON key file downloaded from Google Cloud...
GOOGLE_SERVICE_ACCOUNT_FILE=
# ...or the whole JSON key on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
